PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=P-75H6365063563890NNLOIKLI
PAYPAL_WEBHOOK_ID=
# Sandbox default. For live payments, set to https://api-m.paypal.com
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
