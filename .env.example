# ============================================================
# EAGLETRADE - Fyers API configuration (optional)
# ============================================================
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_ACCESS_TOKEN=

# ============================================================
# Neon PostgreSQL (required for online persistence)
# Create a project at https://neon.tech, then copy the connection
# string from the Neon dashboard. Keep this secret server-side.
# Use the pooled connection string and require SSL.
# ============================================================
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Server configuration
HOST=0.0.0.0
PORT=8000
